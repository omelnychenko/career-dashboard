# The payload, in every shape it takes on disk: the generator's output, a copy
# saved from the browser, and hand-made backups. It carries company names,
# salary asks and interview feedback — it belongs in KV, never in the repo.
payload.json
data.json
data*.json
payload*.json

# Secrets wrangler reads for local runs.
.dev.vars
.dev.vars.*
.env
.env.*

# Wrangler's local state — includes a full copy of the KV payload and the
# resolved account id.
.wrangler/

__pycache__/
*.pyc
.venv/
node_modules/

.DS_Store
.claude/
.idea/
.vscode/
